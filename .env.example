# Discord Webhook URL for inventory alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Optional: HTTP/HTTPS proxy URL (e.g. http://username:password@proxy.example.com:8080)
PROXY_URL=

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
